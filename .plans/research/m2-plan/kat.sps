#!r6rs
;; blake2b-kat.txt through crypto_generichash (outlen 64, keylen 64) on LIBRARY,
;; and the abc/empty hashes at 32 and 64. Usage: scheme --program kat.sps LIBRARY KAT
(import (chezscheme))
(define args (cdr (command-line)))
(load-shared-object (car args))
(define init (foreign-procedure "sodium_init" () int))
(define gh (foreign-procedure "crypto_generichash" (uptr size_t uptr unsigned-64 uptr size_t) int))
(init)
(define (hex->bv s) (let* ((n (quotient (string-length s) 2)) (bv (make-bytevector n)))
  (do ((i 0 (+ i 1))) ((= i n) bv) (bytevector-u8-set! bv i (string->number (substring s (* 2 i) (+ 2 (* 2 i))) 16)))))
(define (bv->hex bv) (string-downcase (apply string-append (map (lambda (b) (string-append (if (< b 16) "0" "") (number->string b 16))) (bytevector->u8-list bv)))))
(define (->block bv) (let* ((n (bytevector-length bv)) (b (foreign-alloc (max n 1))))
  (foreign-set! 'unsigned-8 b 0 0)
  (do ((i 0 (+ i 1))) ((= i n) b) (foreign-set! 'unsigned-8 b i (bytevector-u8-ref bv i)))))
(define (hash in key outlen)
  (let ((ib (->block in)) (kb (->block key)) (ob (foreign-alloc outlen)))
    (let ((r (gh ob outlen ib (bytevector-length in) kb (bytevector-length key))))
      (let ((out (make-bytevector outlen)))
        (do ((i 0 (+ i 1))) ((= i outlen)) (bytevector-u8-set! out i (foreign-ref 'unsigned-8 ob i)))
        (foreign-free ib) (foreign-free kb) (foreign-free ob)
        (cons r out)))))
(define (lines p) (call-with-input-file p (lambda (port) (let loop ((acc '())) (let ((l (get-line port))) (if (eof-object? l) (reverse acc) (loop (cons l acc))))))))
(define (field l tag) (and (>= (string-length l) (string-length tag)) (string=? (substring l 0 (string-length tag)) tag) (substring l (string-length tag) (string-length l))))
(define (strip s) (let loop ((s s)) (if (and (> (string-length s) 0) (memv (string-ref s (- (string-length s) 1)) '(#\return #\space #\tab))) (loop (substring s 0 (- (string-length s) 1))) s)))
(let loop ((ls (lines (cadr args))) (in #f) (key #f) (n 0) (ok 0))
  (cond
    ((null? ls) (printf "KAT entries ~s, matches ~s\n" n ok))
    ((field (car ls) "in:\t") => (lambda (v) (loop (cdr ls) (strip v) key n ok)))
    ((field (car ls) "key:\t") => (lambda (v) (loop (cdr ls) in (strip v) n ok)))
    ((field (car ls) "hash:\t") =>
     (lambda (v)
       (let* ((r (hash (hex->bv in) (hex->bv key) 64)))
         (loop (cdr ls) #f #f (+ n 1) (if (and (= (car r) 0) (string=? (bv->hex (cdr r)) (strip v))) (+ ok 1) ok)))))
    ((and (string=? (car ls) "in:")) (loop (cdr ls) "" key n ok))
    (else (loop (cdr ls) in key n ok))))
(for-each (lambda (p) (printf "blake2b-~a ~a ~a\n" (* 8 (car p)) (cadr p) (bv->hex (cdr (hash (caddr p) (make-bytevector 0) (car p))))))
  (list (list 32 "abc" (string->utf8 "abc")) (list 32 "empty" (make-bytevector 0))
        (list 64 "abc" (string->utf8 "abc")) (list 64 "empty" (make-bytevector 0))))
