#!r6rs
;; Item 3: return codes of crypto_generichash, sodium_memcmp, randombytes_buf,
;; through Chez's FFI with foreign-alloc blocks, after sodium_init. Bound with
;; brief 11.7's types: size_t, unsigned-64 (unsigned long long), uptr, int, void.
;; Usage: scheme --program codes.sps LIBRARY
(import (chezscheme))
(define path (cadr (command-line)))
(load-shared-object path)
(define version-string (foreign-procedure "sodium_version_string" () uptr))
(define (c-string a)
  (let loop ((i 0) (acc '()))
    (let ((b (foreign-ref 'unsigned-8 a i)))
      (if (= b 0) (list->string (reverse acc)) (loop (+ i 1) (cons (integer->char b) acc))))))
(define init (foreign-procedure "sodium_init" () int))
(define generichash
  (foreign-procedure "crypto_generichash" (uptr size_t uptr unsigned-64 uptr size_t) int))
(define memcmp* (foreign-procedure "sodium_memcmp" (uptr uptr size_t) int))
(define randombytes-buf (foreign-procedure "randombytes_buf" (uptr size_t) void))
(printf "library ~a, version ~a\n" path (c-string (version-string)))
(printf "sodium_init ~s\n" (init))

(define (make-block n fill)
  (let ((b (foreign-alloc (max n 1))))
    (do ((i 0 (+ i 1))) ((= i (max n 1))) (foreign-set! 'unsigned-8 b i fill))
    b))
(define (block->list b n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons (foreign-ref 'unsigned-8 b i) acc)))))
(define (hex l) (string-downcase (apply string-append (map (lambda (x) (string-append (if (< x 16) "0" "") (number->string x 16))) l))))
(define (all-equal? l v) (for-each (lambda (x) #t) l) (let loop ((l l)) (or (null? l) (and (= (car l) v) (loop (cdr l))))))

;; --- generichash
(define sentinel #x5a)
(define in (make-block 3 0))
(foreign-set! 'unsigned-8 in 0 97) (foreign-set! 'unsigned-8 in 1 98) (foreign-set! 'unsigned-8 in 2 99)
(define key (make-block 80 #x11))
(define one (make-block 1 0))
(printf "\n== crypto_generichash, input \"abc\" (3 bytes), key block of 80 bytes of 0x11\n")
(printf "outlen keylen -> answer; out written?; (out block is 128 bytes of 0x5a first)\n")
(define (try outlen keylen)
  (let ((out (make-block 128 sentinel)))
    (let ((r (generichash out outlen in 3 key keylen)))
      (let* ((bytes (block->list out 128))
             (written (not (all-equal? bytes sentinel)))
             ;; for success: only the first outlen bytes may change
             (tail-intact (all-equal? (list-tail bytes (min outlen 128)) sentinel)))
        (printf "  outlen ~a keylen ~a -> ~s; out written: ~a~a\n" outlen keylen r written
                (if (= r 0) (format "; bytes past outlen intact: ~a" tail-intact) ""))
        (foreign-free out)
        r))))
(for-each (lambda (o) (try o 0)) '(0 1 15 16 32 64 65))
(printf "-- keylen sweep at outlen 32\n")
(for-each (lambda (k) (try 32 k)) '(0 1 15 16 64 65))
(printf "-- extremes\n")
(try 32 128)
(try 128 0)

(printf "\n== inlen 0 with a one-byte block, unkeyed (key block, keylen 0)\n")
(let ((out (make-block 32 sentinel)))
  (printf "  answer ~s\n  out ~a\n" (generichash out 32 one 0 one 0) (hex (block->list out 32))))

(printf "\n== keylen 0: does the key block matter?\n")
(let* ((keyblk-a (make-block 64 #x00)) (keyblk-b (make-block 64 #xff)) (keyblk-c (make-block 64 #xa5))
       (o1 (make-block 32 0)) (o2 (make-block 32 0)) (o3 (make-block 32 0)) (o4 (make-block 32 0)))
  (generichash o1 32 in 3 keyblk-a 0)
  (generichash o2 32 in 3 keyblk-b 0)
  (generichash o3 32 in 3 keyblk-c 0)
  (generichash o4 32 in 3 key 0)
  (printf "  key block 0x00: ~a\n  key block 0xff: ~a\n  key block 0xa5: ~a\n  key block 0x11 (80): ~a\n"
          (hex (block->list o1 32)) (hex (block->list o2 32)) (hex (block->list o3 32)) (hex (block->list o4 32)))
  (printf "  all four equal: ~a\n" (let ((l1 (block->list o1 32))) (and (equal? l1 (block->list o2 32)) (equal? l1 (block->list o3 32)) (equal? l1 (block->list o4 32)))))
  (let ((o5 (make-block 32 0)))
    (generichash o5 32 in 3 key 16)
    (printf "  for contrast, keylen 16 differs from unkeyed: ~a\n" (not (equal? (block->list o5 32) (block->list o1 32))))))

;; --- sodium_memcmp
(printf "\n== sodium_memcmp\n")
(define (bytes-block l) (let ((b (make-block (length l) 0))) (let loop ((l l) (i 0)) (unless (null? l) (foreign-set! 'unsigned-8 b i (car l)) (loop (cdr l) (+ i 1)))) b))
(define (cmp name l1 l2)
  (printf "  ~a -> ~s\n" name (memcmp* (bytes-block l1) (bytes-block l2) (length l1))))
(cmp "equal, 16 bytes" (iota 16) (iota 16))
(cmp "differ in first byte only (0 vs 1)" (cons 0 (cdr (iota 16))) (cons 1 (cdr (iota 16))))
(cmp "differ in first byte only (1 vs 0)" (cons 1 (cdr (iota 16))) (cons 0 (cdr (iota 16))))
(cmp "differ in first byte only (0x00 vs 0xff)" (cons 0 (cdr (iota 16))) (cons 255 (cdr (iota 16))))
(cmp "differ in first byte only (0xff vs 0x00)" (cons 255 (cdr (iota 16))) (cons 0 (cdr (iota 16))))
(let ((a (iota 16)) (b (append (iota 15) '(99)))) (cmp "differ in last byte only (15 vs 99)" a b) (cmp "differ in last byte only (99 vs 15)" b a))
(cmp "differ in last byte only (0xff vs 0x00)" (append (iota 15) '(255)) (append (iota 15) '(0)))
(cmp "all bytes differ (0x00s vs 0xffs)" (make-list 16 0) (make-list 16 255))
(printf "  length 0, two distinct one-byte blocks (7 vs 9) -> ~s\n" (memcmp* (bytes-block '(7)) (bytes-block '(9)) 0))
(printf "  length 1, equal -> ~s; length 1, 7 vs 9 -> ~s; 9 vs 7 -> ~s\n"
        (memcmp* (bytes-block '(7)) (bytes-block '(7)) 1) (memcmp* (bytes-block '(7)) (bytes-block '(9)) 1) (memcmp* (bytes-block '(9)) (bytes-block '(7)) 1))
(printf "  same block against itself, length 16 -> ~s\n" (let ((b (bytes-block (iota 16)))) (memcmp* b b 16)))
(printf "  exhaustive: every single-byte pair (a,b), a /= b: set of answers ")
(let ((answers '()))
  (do ((a 0 (+ a 1))) ((= a 256))
    (do ((b 0 (+ b 1))) ((= b 256))
      (let ((blk-a (bytes-block (list a))) (blk-b (bytes-block (list b))))
        (let ((r (memcmp* blk-a blk-b 1)))
          (unless (or (member (list (= a b) r) answers)) (set! answers (cons (list (= a b) r) answers)))
          (foreign-free blk-a) (foreign-free blk-b)))))
  (printf "(equal? answer) pairs seen: ~s\n" answers))

;; --- randombytes_buf size 0
(printf "\n== randombytes_buf, size 0 on a one-byte block\n")
(let ((b (make-block 1 #xa5)))
  (let ((before (foreign-ref 'unsigned-8 b 0)))
    (randombytes-buf b 0)
    (printf "  byte before ~a, after ~a\n" before (foreign-ref 'unsigned-8 b 0))))
(let ((b (make-block 16 0)))
  (randombytes-buf b 16)
  (printf "  size 16 into zeroes: ~a\n" (hex (block->list b 16))))
