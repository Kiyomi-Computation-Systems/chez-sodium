;; Does libsodium accept passwd = NULL with passwdlen 0, hash and verify?
;; If it does, the empty-password row cannot tell a NULL pointer from a block.
(define lib (cadr (command-line)))
(load-shared-object lib)
(define sodium-init (foreign-procedure "sodium_init" () int))
(define pwhash-str (foreign-procedure "crypto_pwhash_str" (uptr uptr unsigned-64 unsigned-64 size_t) int))
(define pwhash-verify (foreign-procedure "crypto_pwhash_str_verify" (uptr uptr unsigned-64) int))
(define memcmp (foreign-procedure "sodium_memcmp" (uptr uptr size_t) int))
(define generichash (foreign-procedure "crypto_generichash" (uptr size_t uptr unsigned-64 uptr size_t) int))
(define randombytes-buf (foreign-procedure "randombytes_buf" (uptr size_t) void))
(sodium-init)
(define out (foreign-alloc 128))
(define one (foreign-alloc 1))
(foreign-set! 'unsigned-8 one 0 (char->integer #\a))
(let* ((h (pwhash-str out 0 0 1 8192))
       (v-null (pwhash-verify out 0 0))
       (v-a (pwhash-verify out one 1)))
  (printf "hash(NULL,0) ~a; verify(NULL,0) ~a; verify(\"a\") ~a\n" h v-null v-a))
(let* ((m (memcmp 0 0 0)) (g (generichash out 32 0 0 0 0)))
  (randombytes-buf 0 0)
  (printf "sodium_memcmp(NULL,NULL,0) ~a; generichash(in=NULL,0) ~a; randombytes_buf(NULL,0) returned\n" m g))
