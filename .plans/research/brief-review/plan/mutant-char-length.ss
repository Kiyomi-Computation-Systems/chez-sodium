;; A mutant binding: passes (string-length pw), the character count, as
;; passwdlen instead of the UTF-8 byte count. Which of the brief's section 8
;; password rows would it pass?
(define lib (cadr (command-line)))
(load-shared-object lib)
(define sodium-init (foreign-procedure "sodium_init" () int))
(define pwhash-str (foreign-procedure "crypto_pwhash_str" (uptr uptr unsigned-64 unsigned-64 size_t) int))
(define pwhash-verify (foreign-procedure "crypto_pwhash_str_verify" (uptr uptr unsigned-64) int))
(sodium-init)
(define (block bv)
  (let ((p (foreign-alloc (max 1 (bytevector-length bv)))))
    (do ((i 0 (+ i 1))) ((= i (bytevector-length bv)) p)
      (foreign-set! 'unsigned-8 p i (bytevector-u8-ref bv i)))))
(define (mutant-hash pw)
  (let ((out (foreign-alloc 128)) (p (block (string->utf8 pw))))
    (pwhash-str out p (string-length pw) 1 8192) out))
(define (mutant-verify h pw)
  (zero? (pwhash-verify h (block (string->utf8 pw)) (string-length pw))))
(define (row name v) (printf "~a: ~a\n" name v))
(let ((h (mutant-hash "pässwörd")))
  (row "round trip, right password verifies" (mutant-verify h "pässwörd"))
  (row "changed first char verifies (should be #f)" (mutant-verify h "xässwörd"))
  (row "changed last char verifies (should be #f)" (mutant-verify h "pässwörx")))
(let ((h (mutant-hash "")))
  (row "empty verifies" (mutant-verify h ""))
  (row "one-byte against empty (should be #f)" (mutant-verify h "a")))
(let ((h (mutant-hash "a\x0;b")) (ha (mutant-hash "a")))
  (row "a<NUL>b against its own" (mutant-verify h "a\x0;b"))
  (row "a<NUL>b against a's (should be #f)" (mutant-verify ha "a\x0;b")))
