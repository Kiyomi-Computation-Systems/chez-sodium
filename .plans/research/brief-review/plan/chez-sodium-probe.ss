;; Loads libsodium by the path in argv, calls the Tier 1 subset through
;; foreign blocks only (no Scheme object crosses), and prints what came back.
;; Run: scheme --script chez-sodium-probe.ss LIB [ops mem]
(define lib (cadr (command-line)))
(load-shared-object lib)
(define sodium-init (foreign-procedure "sodium_init" () int))
(define strbytes (foreign-procedure "crypto_pwhash_strbytes" () size_t))
(define ops-min (foreign-procedure "crypto_pwhash_opslimit_min" () size_t))
(define mem-min (foreign-procedure "crypto_pwhash_memlimit_min" () size_t))
(define pwhash-str (foreign-procedure __collect_safe "crypto_pwhash_str" (uptr uptr unsigned-64 unsigned-64 size_t) int))
(define pwhash-verify (foreign-procedure __collect_safe "crypto_pwhash_str_verify" (uptr uptr unsigned-64) int))
(define needs-rehash (foreign-procedure "crypto_pwhash_str_needs_rehash" (uptr unsigned-64 size_t) int))
(define randombytes-buf (foreign-procedure "randombytes_buf" (uptr size_t) void))
(define generichash (foreign-procedure "crypto_generichash" (uptr size_t uptr unsigned-64 uptr size_t) int))
(define memcmp (foreign-procedure "sodium_memcmp" (uptr uptr size_t) int))
(define memzero (foreign-procedure "sodium_memzero" (uptr size_t) void))

(define (bytes->block bv)
  (let* ((n (max 1 (bytevector-length bv))) (p (foreign-alloc n)))
    (do ((i 0 (+ i 1))) ((= i (bytevector-length bv)) p)
      (foreign-set! 'unsigned-8 p i (bytevector-u8-ref bv i)))))
(define (block->bytes p n)
  (let ((bv (make-bytevector n)))
    (do ((i 0 (+ i 1))) ((= i n) bv)
      (bytevector-u8-set! bv i (foreign-ref 'unsigned-8 p i)))))
(define (block->string p)
  (let loop ((i 0) (acc '()))
    (let ((b (foreign-ref 'unsigned-8 p i)))
      (if (= b 0) (utf8->string (u8-list->bytevector (reverse acc))) (loop (+ i 1) (cons b acc))))))

(define args (cddr (command-line)))
(define ops (if (null? args) (ops-min) (string->number (car args))))
(define mem (if (null? args) (mem-min) (string->number (cadr args))))
(let* ((a (sodium-init)) (b (sodium-init))) (printf "sodium_init ~a then ~a\n" a b))
(define (hash pw)
  (let* ((bv (string->utf8 pw)) (p (bytes->block bv)) (out (foreign-alloc (strbytes))))
    (let ((rc (pwhash-str out p (bytevector-length bv) ops mem)))
      (memzero p (max 1 (bytevector-length bv)))
      (foreign-free p)
      (let ((s (and (= rc 0) (block->string out)))) (foreign-free out) s))))
(define (verify h pw)
  (let* ((hb (string->utf8 h)) (hp (bytes->block (bytevector-append hb (bytevector 0))))
         (bv (string->utf8 pw)) (p (bytes->block bv)))
    (let ((rc (pwhash-verify hp p (bytevector-length bv))))
      (memzero p (max 1 (bytevector-length bv))) (foreign-free p) (foreign-free hp) rc)))
(define (bytevector-append a b)
  (let ((r (make-bytevector (+ (bytevector-length a) (bytevector-length b)))))
    (bytevector-copy! a 0 r 0 (bytevector-length a))
    (bytevector-copy! b 0 r (bytevector-length a) (bytevector-length b)) r))
(define t0 (real-time))
(define h (hash "pässwörd"))
(define t1 (real-time))
(printf "hash ~a ms: ~a\n" (- t1 t0) h)
(let* ((r (verify h "pässwörd")) (w (verify h "pässwörx")) (n (verify (hash "a\x0;b") "a"))) (printf "verify right ~a, wrong ~a, NUL-password ~a\n" r w n))
(define hp (bytes->block (bytevector-append (string->utf8 h) (bytevector 0))))
(let* ((a (needs-rehash hp ops mem)) (b (needs-rehash hp (+ ops 1) mem))) (printf "needs_rehash same ~a, higher ~a\n" a b))
(foreign-free hp)
(define rb (foreign-alloc 32))
(randombytes-buf rb 32)
(printf "random ~a\n" (block->bytes rb 32))
(foreign-free rb)
(define in (bytes->block (string->utf8 "abc")))
(define out (foreign-alloc 64))
(let* ((rc (generichash out 64 in 3 0 0)) (bs (block->bytes out 64))) (printf "generichash rc ~a: ~a\n" rc bs))
(foreign-free in) (foreign-free out)
(define a (bytes->block (bytevector 1 2 3))) (define b (bytes->block (bytevector 1 2 4)))
(let* ((x (memcmp a a 3)) (y (memcmp a b 3)) (z (memcmp a b 0))) (printf "memcmp equal ~a unequal ~a len0 ~a\n" x y z))
(foreign-free a) (foreign-free b)
(printf "foreign-alloc 0: ~a\n" (guard (e (#t (list 'raised (condition-message e) (condition-irritants e)))) (foreign-alloc 0)))
