  long valid hash -> "$argon2id$v=19$m=8,t=1,p=1$EAAu4+gkKLTvdoj0N/zgmw$FWWd7isOHvUNPl7YyyDl0ZEGcFWN+VAGoPfFLwvoI4vWgnMarKuw6kN1lH1Iw98zAvQe7ZwNx3akE3MI4F3PRw"
    its length (strbytes is 128) -> 136
    right password -> 0
    wrong password -> -1
  non-ASCII password as UTF-8 (byte length) -> 13
    against its own hash -> 0
    same text, last character changed (euro -> $) -> -1
    its Latin-1 bytes (euro as 0x80) -> -1
    its Latin-1 bytes, euro dropped -> -1
    ASCII-only prefix "pässwörd" as UTF-8 -> -1

== 5c. crypto_pwhash_str_needs_rehash (hash of "pw" at ops 1, mem 8192 unless stated)
  same limits -> 0
  ops+1 -> 1
  memory x2 -> 1
  memory +1023 bytes -> 0
  memory +1024 bytes -> 1
  memory -1 byte -> 1
  hash made at ops 3: against ops 3 -> 0
  hash made at ops 3: against ops 1 (lower) -> 1
  hash made at mem 4x min: against min mem (lower) -> 1
  "garbage" -> -1
  the long valid hash (length > strbytes) -> -1
  the long valid hash, against ops+1 -> -1
  argon2i string (from the file) -> "$argon2i$v=19$m=8,t=3,p=1$M7piIWNtEXiEBDILqW0joQ$YvJYnNYtgmsRVSqwuv5bVM30pd8Gomfs5DL4FSDZfCA"
    verify, right password -> 0
    needs_rehash at ops 3, min mem (same limits) -> 0
    needs_rehash at ops 4 -> 1
  p=4 at the same t and m -> -1
  p=0 -> -1
  prefix $argon2d$ -> -1
  prefix $argon2i$ (with the argon2id hash's v, t, m) -> 0
  no $v= -> -1
  $v=16 -> -1
  "$argon2id" with no trailing $, no rest -> -1
  one byte >= 0x80 (0xc3) as the salt's first character -> 0
    the same string, verify -> -1
  (m=64 KiB hash: unedited, same limits) -> 0
  (m=64 KiB hash) p=4 at the same t and m (p=4 needs m >= 32 KiB) -> 0
  (m=64 KiB hash) p=2 at the same t and m -> 0
  (m=64 KiB hash) p=4, verify (tag is for p=1) -> -1
  the hash then "\0junk" -> 0
  ops 0 -> 1
  memory 0 -> 1
  ops 0 and memory 0 -> 1
  ops 2^32 -> -1
  ops 2^32-1 and memory = memlimit_max -> 1
  ops 2^64-1 and memory 2^64-1 -> -1

