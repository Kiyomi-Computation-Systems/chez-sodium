#!r6rs
;; Item 5: return codes of crypto_pwhash_str, _str_verify, _str_needs_rehash through Chez's FFI.
;; Plain bindings: uptr for every pointer, unsigned-64 for unsigned long long, size_t for size_t.
;; Blocks are foreign-alloc'd, hold the bytes then a 0, and are freed after.
;; Usage: scheme --program codes.sps LIBRARY ARGON2I-STRING-FILE
(import (chezscheme))
(define args (command-line))
(define path (cadr args))
(define argon2i-file (caddr args))
(load-shared-object path)
(define (c-string a)
  (let loop ((i 0) (acc '()))
    (let ((b (foreign-ref 'unsigned-8 a i)))
      (if (= b 0) (list->string (reverse acc)) (loop (+ i 1) (cons (integer->char b) acc))))))
(define version-string (foreign-procedure "sodium_version_string" () uptr))
(define init (foreign-procedure "sodium_init" () int))
(define pwhash-str (foreign-procedure "crypto_pwhash_str" (uptr uptr unsigned-64 unsigned-64 size_t) int))
(define pwhash-str-verify (foreign-procedure "crypto_pwhash_str_verify" (uptr uptr unsigned-64) int))
(define pwhash-str-needs-rehash (foreign-procedure "crypto_pwhash_str_needs_rehash" (uptr unsigned-64 size_t) int))
(define pwhash-raw (foreign-procedure "crypto_pwhash" (uptr unsigned-64 uptr unsigned-64 uptr unsigned-64 size_t int) int))
(define randombytes-buf (foreign-procedure "randombytes_buf" (uptr size_t) void))
(define bin2base64 (foreign-procedure "sodium_bin2base64" (uptr size_t uptr size_t int) uptr))
(define (limit n) ((eval `(foreign-procedure ,n () size_t))))
(printf "library ~a, version ~a\n" path (c-string (version-string)))
(printf "sodium_init ~s\n" (init))
(define OPS (limit "crypto_pwhash_opslimit_min"))
(define OPS-MAX (limit "crypto_pwhash_opslimit_max"))
(define MEM (limit "crypto_pwhash_memlimit_min"))
(define MEM-MAX (limit "crypto_pwhash_memlimit_max"))
(define STRBYTES (limit "crypto_pwhash_strbytes"))
(printf "min limits: ops ~a mem ~a; strbytes ~a\n" OPS MEM STRBYTES)

;; ---- helpers
(define (make-block n fill)
  (let ((b (foreign-alloc (max n 1))))
    (do ((i 0 (+ i 1))) ((= i (max n 1))) (foreign-set! 'unsigned-8 b i fill))
    b))
(define (bv->block bv)                  ; the bytes, then a 0
  (let ((b (make-block (+ (bytevector-length bv) 1) 0)))
    (do ((i 0 (+ i 1))) ((= i (bytevector-length bv)) b)
      (foreign-set! 'unsigned-8 b i (bytevector-u8-ref bv i)))))
(define (block->bv b n)
  (let ((bv (make-bytevector n)))
    (do ((i 0 (+ i 1))) ((= i n) bv) (bytevector-u8-set! bv i (foreign-ref 'unsigned-8 b i)))))
(define (bv-strlen bv) (let loop ((i 0)) (if (or (= i (bytevector-length bv)) (= 0 (bytevector-u8-ref bv i))) i (loop (+ i 1)))))
(define (bv-cstr bv) (utf8->string (bytevector-truncate! (bytevector-copy bv) (bv-strlen bv))))
(define (bv-count bv from v) (let loop ((i from) (n 0)) (if (= i (bytevector-length bv)) n (loop (+ i 1) (if (= v (bytevector-u8-ref bv i)) (+ n 1) n)))))
(define (u8 s) (string->utf8 s))
(define (bv-append . l)
  (let* ((n (apply + (map bytevector-length l))) (r (make-bytevector n)))
    (let loop ((l l) (at 0))
      (if (null? l) r
          (begin (bytevector-copy! (car l) 0 r at (bytevector-length (car l)))
                 (loop (cdr l) (+ at (bytevector-length (car l)))))))))
(define (with-block bv proc) (let* ((b (bv->block bv)) (r (proc b))) (foreign-free b) r))

;; (hash pw ops mem) -> (values answer 128-byte out as bytevector, out prefilled with 0x5a)
(define (hash pw ops mem)
  (let ((out (make-block STRBYTES #x5a)))
    (let ((r (with-block pw (lambda (p) (pwhash-str out p (bytevector-length pw) ops mem)))))
      (let ((bv (block->bv out STRBYTES))) (foreign-free out) (values r bv)))))
(define (hash-string pw ops mem)
  (let-values (((r bv) (hash pw ops mem)))
    (if (= r 0) (bytevector-truncate! (bytevector-copy bv) (bv-strlen bv)) (error 'hash-string "failed" r))))
(define (verify s pw)
  (with-block s (lambda (sb) (with-block pw (lambda (pb) (pwhash-str-verify sb pb (bytevector-length pw)))))))
(define (rehash s ops mem) (with-block s (lambda (sb) (pwhash-str-needs-rehash sb ops mem))))
(define (say what r) (printf "  ~a -> ~s\n" what r))
(define PW (u8 "pw"))
(define (string-index s c) (let loop ((i 0)) (cond ((= i (string-length s)) #f) ((char=? c (string-ref s i)) i) (else (loop (+ i 1))))))
(define (split s c) (let loop ((i 0) (st 0) (acc '()))
  (cond ((= i (string-length s)) (reverse (cons (substring s st i) acc)))
        ((char=? c (string-ref s i)) (loop (+ i 1) (+ i 1) (cons (substring s st i) acc)))
        (else (loop (+ i 1) st acc)))))
(define (replace-first s from to)       ; strings, first occurrence
  (let ((n (string-length from)))
    (let loop ((i 0))
      (cond ((> (+ i n) (string-length s)) (error 'replace "absent" from))
            ((string=? from (substring s i (+ i n))) (string-append (substring s 0 i) to (substring s (+ i n) (string-length s))))
            (else (loop (+ i 1)))))))
(define (b64 bv)
  (let* ((n (bytevector-length bv)) (out (make-block (+ 4 (* 2 n)) 0)) (inb (bv->block bv)))
    (bin2base64 out (+ 4 (* 2 n)) inb n 3)
    (let ((s (c-string out))) (foreign-free out) (foreign-free inb) s)))
(define (pfields s) (split s #\$))       ; ("" "argon2id" "v=19" "m=..,t=..,p=.." salt tag)

;; ================= a. crypto_pwhash_str
(printf "\n== 5a. crypto_pwhash_str (hash of \"pw\", min limits unless stated; out is 128 bytes of 0x5a first)\n")
(let-values (((r bv) (hash PW OPS MEM)))
  (let* ((len (bv-strlen bv)) (z (bv-count bv (+ len 1) 0)) (f (bv-count bv (+ len 1) #x5a)))
    (say "in range: answer" r)
    (say "in range: string length" len)
    (say (format "in range: bytes after the NUL up to strbytes (~a of them): zero / still 0x5a" (- STRBYTES len 1)) (list z f))
    (say "in range: string" (bv-cstr bv))))
(define (minus1 what pw ops mem)
  (let-values (((r bv) (hash pw ops mem)))
    (say (string-append what ": answer; out bytes all 0 / count of 0x5a left") (list r (= (bv-count bv 0 0) STRBYTES) (bv-count bv 0 #x5a)))))
(minus1 "ops 0 (below min)" PW 0 MEM)
(minus1 "ops 2^32 (above max)" PW (expt 2 32) MEM)
(minus1 "ops 2^64-1 (above max)" PW (- (expt 2 64) 1) MEM)
(minus1 "mem 0 (below min)" PW OPS 0)
(minus1 "mem min-1 (below min)" PW OPS (- MEM 1))
(minus1 "mem max+1 (above max; fits size_t)" PW OPS (+ MEM-MAX 1))
(minus1 "mem 2^64-1 (above max; largest size_t)" PW OPS (- (expt 2 64) 1))
(say "mem max+1 fits size_t (< 2^64)" (< (+ MEM-MAX 1) (expt 2 64)))
(let ((out (make-block STRBYTES #x5a)) (one (make-block 1 #x41)))
  (say "empty password, 1-byte block, length 0: answer" (pwhash-str out one 0 OPS MEM))
  (say "  its string" (c-string out))
  (foreign-free out) (foreign-free one))
(let-values (((r bv) (hash PW 2 (+ (* 16 1024) 1))))
  (say "ops 2, mem 16*1024+1: answer" r)
  (let ((fs (pfields (bv-cstr bv))))
    (say "  whole parameter field" (cadddr fs))
    (say "  memory floored to whole KiB (m=16)" (string=? (cadddr fs) "m=16,t=2,p=1"))))
(let-values (((r bv) (hash PW 2 (* 16 1024))))
  (let* ((s (bv-cstr bv)) (fs (pfields s)))
    (say "ops 2, mem 16 KiB: answer" r)
    (say "  whole string" s)
    (say "  whole parameter field" (cadddr fs))
    (say "  fields (prefix, version, params, salt chars, tag chars)"
         (list (string-append "$" (cadr fs) "$") (caddr fs) (cadddr fs) (string-length (list-ref fs 4)) (string-length (list-ref fs 5))))
    (say "  total length" (string-length s))))

;; ================= b. crypto_pwhash_str_verify
(printf "\n== 5b. crypto_pwhash_str_verify (password \"pw\", min limits unless stated)\n")
(define H (hash-string PW OPS MEM))
(define Hs (bv-cstr H))
(say "hash" Hs)
(say "right password" (verify H PW))
(say "wrong password" (verify H (u8 "pX")))
(say "\"garbage\"" (verify (u8 "garbage") PW))
(say "\"\"" (verify (u8 "") PW))
(say "hash then \"\\0junk\" (block holds the bytes after the NUL)" (verify (bv-append H (bytevector 0) (u8 "junk")) PW))
(say "hash then \"junk\"" (verify (bv-append H (u8 "junk")) PW))
(say "hash then \"\\n\"" (verify (bv-append H (u8 "\n")) PW))
(say "space then hash" (verify (bv-append (u8 " ") H) PW))
(define A0B (bytevector 97 0 98))
(define HA0B (hash-string A0B OPS MEM))
(say "\"a\\0b\" (length 3) against its own hash" (verify HA0B A0B))
(say "\"a\" (length 1) against \"a\\0b\"'s hash" (verify HA0B (u8 "a")))
(define HE (hash-string (u8 "") OPS MEM))
(say "empty password against its own hash" (verify HE (u8 "")))
(say "\"x\" against the empty password's hash" (verify HE (u8 "x")))
;; long valid hash: argon2id, 64-byte tag, built by hand
(define LONG
  (let ((salt (make-block 16 0)) (tag (make-block 64 0)) (pwb (bv->block PW)))
    (randombytes-buf salt 16)
    (let ((r (pwhash-raw tag 64 pwb 2 salt OPS MEM 2)))
      (unless (= r 0) (error 'long "crypto_pwhash failed" r))
      (let ((s (u8 (format "$argon2id$v=19$m=~a,t=~a,p=1$~a$~a" (div MEM 1024) OPS (b64 (block->bv salt 16)) (b64 (block->bv tag 64))))))
        (foreign-free salt) (foreign-free tag) (foreign-free pwb) s))))
(say "long valid hash" (utf8->string LONG))
(say "  its length (strbytes is 128)" (bytevector-length LONG))
(say "  right password" (verify LONG PW))
(say "  wrong password" (verify LONG (u8 "pX")))
(define UPW (u8 "pässwörd€"))
(define UBAD (u8 "pässwörd$"))
(define LATIN1 (bytevector 112 #xe4 115 115 119 #xf6 114 100 #x80)) ; \x80 is the euro in Windows-1252; Latin-1 has none
(define LATIN1b (bytevector 112 #xe4 115 115 119 #xf6 114 100))
(define HU (hash-string UPW OPS MEM))
(say "non-ASCII password as UTF-8 (byte length)" (bytevector-length UPW))
(say "  against its own hash" (verify HU UPW))
(say "  same text, last character changed (euro -> $)" (verify HU UBAD))
(say "  its Latin-1 bytes (euro as 0x80)" (verify HU LATIN1))
(say "  its Latin-1 bytes, euro dropped" (verify HU LATIN1b))
(say "  ASCII-only prefix \"pässwörd\" as UTF-8" (verify HU (u8 "pässwörd")))

;; ================= c. crypto_pwhash_str_needs_rehash
(printf "\n== 5c. crypto_pwhash_str_needs_rehash (hash of \"pw\" at ops ~a, mem ~a unless stated)\n" OPS MEM)
(say "same limits" (rehash H OPS MEM))
(say "ops+1" (rehash H (+ OPS 1) MEM))
(say "memory x2" (rehash H OPS (* 2 MEM)))
(say "memory +1023 bytes" (rehash H OPS (+ MEM 1023)))
(say "memory +1024 bytes" (rehash H OPS (+ MEM 1024)))
(say "memory -1 byte" (rehash H OPS (- MEM 1)))
(let ((h3 (hash-string PW 3 MEM)))
  (say "hash made at ops 3: against ops 3" (rehash h3 3 MEM))
  (say "hash made at ops 3: against ops 1 (lower)" (rehash h3 1 MEM)))
(let ((h8 (hash-string PW OPS (* 4 MEM))))
  (say "hash made at mem 4x min: against min mem (lower)" (rehash h8 OPS MEM)))
(say "\"garbage\"" (rehash (u8 "garbage") OPS MEM))
(say "the long valid hash (length > strbytes)" (rehash LONG OPS MEM))
(say "the long valid hash, against ops+1" (rehash LONG (+ OPS 1) MEM))
(define AI (let ((p (open-input-file argon2i-file))) (let ((l (get-line p))) (close-port p) (u8 l))))
(say "argon2i string (from the file)" (utf8->string AI))
(say "  verify, right password" (verify AI PW))
(say "  needs_rehash at ops 3, min mem (same limits)" (rehash AI 3 MEM))
(say "  needs_rehash at ops 4" (rehash AI 4 MEM))
(let* ((s (utf8->string H)))
  (define (str-edit what new) (say what (rehash (u8 new) OPS MEM)))
  (str-edit "p=4 at the same t and m" (replace-first s ",p=1$" ",p=4$"))
  (str-edit "p=0" (replace-first s ",p=1$" ",p=0$"))
  (str-edit "prefix $argon2d$" (replace-first s "$argon2id$" "$argon2d$"))
  (str-edit "prefix $argon2i$ (with the argon2id hash's v, t, m)" (replace-first s "$argon2id$" "$argon2i$"))
  (str-edit "no $v=" (replace-first s "$v=19" ""))
  (str-edit "$v=16" (replace-first s "$v=19" "$v=16"))
  (str-edit "\"$argon2id\" with no trailing $, no rest" "$argon2id")
  (let* ((fs (pfields s)) (salt (list-ref fs 4)) (si (string-length (string-append "$argon2id$" (caddr fs) "$" (cadddr fs) "$"))))
    (let ((bv (bytevector-copy H)))
      (bytevector-u8-set! bv si #xc3)
      (say "one byte >= 0x80 (0xc3) as the salt's first character" (rehash bv OPS MEM))
      (say "  the same string, verify" (verify bv PW)))))
(let* ((h64 (utf8->string (hash-string PW OPS (* 64 1024)))))
  (say "(m=64 KiB hash: unedited, same limits)" (rehash (u8 h64) OPS (* 64 1024)))
  (say "(m=64 KiB hash) p=4 at the same t and m (p=4 needs m >= 32 KiB)" (rehash (u8 (replace-first h64 ",p=1$" ",p=4$")) OPS (* 64 1024)))
  (say "(m=64 KiB hash) p=2 at the same t and m" (rehash (u8 (replace-first h64 ",p=1$" ",p=2$")) OPS (* 64 1024)))
  (say "(m=64 KiB hash) p=4, verify (tag is for p=1)" (verify (u8 (replace-first h64 ",p=1$" ",p=4$")) PW)))
(say "the hash then \"\\0junk\"" (rehash (bv-append H (bytevector 0) (u8 "junk")) OPS MEM))
(say "ops 0" (rehash H 0 MEM))
(say "memory 0" (rehash H OPS 0))
(say "ops 0 and memory 0" (rehash H 0 0))
(say "ops 2^32" (rehash H (expt 2 32) MEM))
(say "ops 2^32-1 and memory = memlimit_max" (rehash H (- (expt 2 32) 1) MEM-MAX))
(say "ops 2^64-1 and memory 2^64-1" (rehash H (- (expt 2 64) 1) (- (expt 2 64) 1)))

;; ================= d. hand-written preset strings
(printf "\n== 5d. hand-written preset strings; rows are strings, columns are limits (ops, mem) of the presets\n")
(define salt16 (let ((bv (make-bytevector 16))) (do ((i 0 (+ i 1))) ((= i 16) bv) (bytevector-u8-set! bv i (+ 65 i)))))
(define tag32 (let ((bv (make-bytevector 32))) (do ((i 0 (+ i 1))) ((= i 32) bv) (bytevector-u8-set! bv i (+ 97 (* 3 i))))))
(define SALT (b64 salt16))
(define TAG (b64 tag32))
(say "salt (chars)" (list SALT (string-length SALT)))
(say "tag (chars)" (list TAG (string-length TAG)))
(define presets
  (list (list "interactive" (limit "crypto_pwhash_opslimit_interactive") (limit "crypto_pwhash_memlimit_interactive"))
        (list "moderate" (limit "crypto_pwhash_opslimit_moderate") (limit "crypto_pwhash_memlimit_moderate"))
        (list "sensitive" (limit "crypto_pwhash_opslimit_sensitive") (limit "crypto_pwhash_memlimit_sensitive"))))
(define (preset-string p salt tag) (u8 (format "$argon2id$v=19$m=~a,t=~a,p=1$~a$~a" (div (caddr p) 1024) (cadr p) salt tag)))
(for-each
 (lambda (row)
   (let ((s (preset-string row SALT TAG)))
     (printf "  ~a: ~a\n    needs_rehash at interactive / moderate / sensitive: ~a\n" (car row) (utf8->string s)
             (map (lambda (col) (rehash s (cadr col) (caddr col))) presets))))
 presets)
(let ((p (cadr presets)))
  (say "salt of 21 chars (last char dropped), moderate string, at moderate limits"
       (rehash (preset-string p (substring SALT 0 21) TAG) (cadr p) (caddr p)))
  (say "tag of 42 chars (last char dropped), moderate string, at moderate limits"
       (rehash (preset-string p SALT (substring TAG 0 42)) (cadr p) (caddr p)))
  (say "control, same string intact at moderate limits" (rehash (preset-string p SALT TAG) (cadr p) (caddr p))))
