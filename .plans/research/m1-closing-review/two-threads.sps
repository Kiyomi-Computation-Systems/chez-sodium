(import (chezscheme))
(define (attempt)
  (guard (e (#t (list 'raised (if (format-condition? e) (condition-message e) e))))
    (eval 'answer (environment '(toy slow)))))
(define m (make-mutex))
(define c (make-condition))
(define first #f)
(fork-thread (lambda () (let ((r (attempt))) (with-mutex m (set! first r) (condition-signal c)))))
(sleep (make-time 'time-duration 100000000 0))
(define second (attempt))
(with-mutex m (let loop () (unless first (condition-wait c m) (loop))))
(define later (attempt))
(write (vector first second (list 'later later))) (newline)
