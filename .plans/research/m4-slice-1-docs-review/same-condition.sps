(import (rnrs) (rnrs eval) (chez-sodium))
(define (once)
  (guard (e ((sodium-library-unavailable? e) e))
    (eval '(sodium-version) (environment '(chez-sodium)))))
(let* ((a (once)) (b (once)))
  (write (list (sodium-library-unavailable-reason a) (eq? a b)
               (length (sodium-library-unavailable-candidates a))
               (sodium-library-unavailable-source a)
               (sodium-library-unavailable-detail a)))
  (newline))
