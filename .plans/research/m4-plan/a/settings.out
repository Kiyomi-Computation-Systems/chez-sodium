{"default_workflow_permissions":"read","can_approve_pull_request_reviews":false}
# The sibling, for comparison
$ gh api repos/Kiyomi-Computation-Systems/chez-sqlite3/pages --jq '{build_type, html_url}'
{"build_type":"workflow","html_url":"https://kiyomi-computation-systems.github.io/chez-sqlite3/"}
$ gh api repos/Kiyomi-Computation-Systems/chez-sqlite3/environments/github-pages/deployment-branch-policies --jq '.branch_policies[] | {name, type}'
{"name":"v*","type":"tag"}
$ gh api repos/Kiyomi-Computation-Systems/chez-sqlite3/rulesets --jq '.[] | {id, name, target, enforcement}'
{"enforcement":"active","id":27776633,"name":"release tags","target":"tag"}
$ gh api repos/Kiyomi-Computation-Systems/chez-sqlite3/branches/main/protection --jq '{contexts: .required_status_checks.contexts, strict: .required_status_checks.strict}'
{"contexts":["main (checks and suites, Chez built from source)","nothreads (every library is refused on a Chez without threads)","floor (the suites against SQLite at its floor, built from source)","current (the suites against the current SQLite, built from source)","memory-1 (the Valgrind gate, shard 1 of 2)","memory-2 (the Valgrind gate, shard 2 of 2)","site (the docs site, on Ubuntu's Chez)"],"strict":true}
